{
  "$schema": "https://deno.land/x/deno/cli/schemas/config-file.v1.json",
  "fmt": {
    "include": [
      "README.md",
      "datastores",
      "external_auth",
      "functions",
      "manifest.ts",
      "tests",
      "triggers",
      "types",
      "views",
      "workflows"
    ]
  },
  "importMap": "import_map.json",
  "lint": {
    "include": [
      "datastores",
      "external_auth",
      "functions",
      "manifest.ts",
      "tests",
      "triggers",
      "types",
      "views",
      "workflows"
    ]
  },
  "lock": false,
  "tasks": {
    // Tests only cover the pure helpers, so type check the Slack functions
    // and triggers (everything reachable from the manifest) explicitly.
    "check": "deno check manifest.ts triggers/",
    "test": "deno fmt --check && deno lint && deno task check && deno test --allow-read"
  }
}
